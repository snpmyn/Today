<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--<widget.carousel.two.CarouselView
        android:id="@+id/carouselActivityCv"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_240"
        app:carouselAutoScroll="true"
        app:carouselEnableAlpha="true"
        app:carouselEnableScale="true"
        app:carouselItemWidth="@dimen/dp_180"
        app:carouselMinAlpha="0.50"
        app:carouselMinScale="0.75"
        app:carouselScrollInterval="3000"
        app:carouselScrollSpeed="120.0"
        app:layout_constraintBottom_toTopOf="@+id/carouselActivityMbtg"
